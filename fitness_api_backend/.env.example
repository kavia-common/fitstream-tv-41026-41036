# Copy this file to .env and adjust values for your environment.
# Do NOT commit real secrets.

# SECURITY
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# DATABASE
# For local development (SQLite file):
DATABASE_URL=sqlite:///./fitness.db
# For Postgres (example):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fitness

# CORS SETTINGS
# Accepts JSON array or comma-separated values. Empty/whitespace treated safely.
# Examples:
# CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
# CORS_ORIGINS=https://app.example.com, https://admin.example.com
# Allowed aliases for compatibility:
# allowed_origins=*
# allowed_headers=*
# allowed_methods=*
CORS_ORIGINS=*
allowed_origins=*
allowed_headers=*
allowed_methods=*

# CORS cache
cors_max_age=600

# OPTIONAL URL HINTS
backend_url=
frontend_url=
site_url=
ws_url=

# SERVER
host=0.0.0.0
uvicorn_host=0.0.0.0
uvicorn_workers=1
port=8000
node_env=development

# LIMITS
request_timeout_ms=30000
rate_limit_window_s=60
rate_limit_max=100
